# Web / Firebase (client bundle — never put a server secret here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Worker -> Render hunter API
HUNTER_API_URL=https://your-render-service.example
HUNTER_SHARED_SECRET=

# Product AI services (server-side only; do not put these in browser code)
FLAGSHIP_ROUTER_URL=
FLAGSHIP_ROUTER_API_KEY=
# Paid models stay off until the owner explicitly authorises them.
PAID_AI_AUTHORIZED=false

# Hunter API (Render)
PORT=8080
FIREBASE_PROJECT_ID=
# Path to a service-account JSON mounted on the host (Render Secret File).
# Never commit the JSON itself.
GOOGLE_APPLICATION_CREDENTIALS=
RUN_TIMEOUT_MS=120000
LOG_LEVEL=info

# Who this deployment serves: "public" (default) or "personal".
# A source whose terms were only verified for private use is NOT crawled in
# public scope. Anything other than an explicit "personal" is treated as public.
HUNT_DEPLOYMENT_SCOPE=public

# Local development only: point the Admin SDK at the Firestore emulator.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Notifications (server-side only; absent means the channel is not dispatched)
# SECRET REQUIRED: Telegram bot token - configure securely in Render; never put a value in this template
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
# Email is sent over an HTTP provider API, never SMTP ports.
EMAIL_HTTP_ENDPOINT=
EMAIL_FROM_ADDRESS=
TELEGRAM_OWNER_CHAT_ID=
NOTIFICATION_OWNER_UID=
